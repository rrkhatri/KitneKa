# ── Live data feed (optional) ───────────────────────────────────────────────
# The app is fully functional with none of these set: the bundled catalogue is
# used as the reference dataset. When QUICKCOMMERCE_FEED_URL is present it is
# queried first for every platform, and the app falls back to the catalogue
# per-platform on any failure.
#
# Point this at whichever of these you actually have:
#   1. A licensed quick-commerce data partner
#   2. Your own scraper running as a sidecar (keeps sessions/parsing out of the
#      web app, where an upstream anti-bot change would take down a page)
#   3. A future official platform API
#
# Expected contract (money is integer paise everywhere):
#   GET {base}/v1/platforms/{platform}/search?q={query}&pincode={pincode}
#     -> { "listings": [ { "id", "title", "imageUrl", "mrpPaise",
#                          "pricePaise", "inStock", "promoLabels",
#                          "packSize", "etaMinutes" } ] }
#   GET {base}/v1/platforms/{platform}/stores
#     -> { "stores": [ { "id", "name", "locality", "city", "pincode",
#                        "lat", "lng", "baseEtaMinutes", "serviceRadiusKm" } ] }
#
# QUICKCOMMERCE_FEED_URL=https://feed.example.com

# Bearer token sent as `Authorization: Bearer <token>` when set.
# QUICKCOMMERCE_FEED_TOKEN=

# Per-request timeout in milliseconds before falling back to the catalogue.
# QUICKCOMMERCE_FEED_TIMEOUT_MS=4000
